public/midi/stems/
# Generated by build-midi.mjs on every dev and release build. It names whatever
# sits in local-midi/, local-audio/, and local-stems/, so tracking it would put
# private song titles into source control even though the media itself is ignored.
public/midi/manifest.json
# Ignore legacy top-level folders whose names begin with a non-ASCII character.
/[!A-Za-z0-9._-]*/
# Commit only the blank English example under the fixed resource directory.
Music Resources/*
!Music Resources/Sample Song/
!Music Resources/Sample Song/**
